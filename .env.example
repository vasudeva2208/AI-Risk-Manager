# Application Configuration
APP_NAME="AI Return Risk Manager"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change_this_in_production_secret_key_1234567890

# Database Configuration
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ai_risk_manager
# For lightweight local development / testing without a live PostgreSQL instance:
# DATABASE_URL=sqlite:///./risk_manager.db

# ML Model Configuration
MODEL_DIR=ml/models/artifacts
ACTIVE_MODEL_VERSION=return-risk-hgb-v1

# Policy & Threshold Configuration
POLICY_THRESHOLD_LOW=0.30
POLICY_THRESHOLD_HIGH=0.70

# Business Cost Parameters ($ USD)
COST_REVIEW_FRICTION=15.00
COST_FALSE_POSITIVE_CHURN=35.00
COST_RETURN_SHIPPING=8.50
